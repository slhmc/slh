# Public application/client identifier. This is not a client secret.
SLH_MICROSOFT_CLIENT_ID=

# Personal CurseForge API key. Never commit a populated .env file.
SLH_CURSEFORGE_API_KEY=

# Audited Ely.by javaagent artifact. Both values are required to launch Ely.by accounts.
SLH_ELY_AUTHLIB_INJECTOR_URL=
SLH_ELY_AUTHLIB_INJECTOR_SHA256=

# Debug/test-only portable root override. Ignored by release builds.
SLH_PORTABLE_ROOT=
