+// SignInDefaultSharedAccount binds the helper to the Windows user's current
+// Store/Xbox account without trying to display UI from the helper process.
+// Only the opaque WAM account id and license keys are persisted with DPAPI.
+func SignInDefaultSharedAccount(ctx context.Context, dir string) (xuid, gamertag string, err error) {
+	if ctx == nil || dir == "" {
+		return "", "", errors.New("invalid account operation")
+	}
+	defer recoverFailure(&err)
+	xuid, gamertag, err = xbox.SignInDefault(ctx, func(id string) error {
+		return saveSharedAccountSelection(dir, id)
+	})
+	if err != nil {
+		accountAuthorizationFailed(err)
+	}
+	return xuid, gamertag, nil
+}
+
