+// SignInDefault selects the Microsoft account that Windows can authorize
+// silently for the current user. This is intended for companion/helper
+// processes which do not own the launcher's UI thread and therefore cannot
+// safely host AccountsSettingsPane. The caller must surface
+// ErrInteractionRequired and ask the user to sign in to Store/Xbox first.
+func SignInDefault(ctx context.Context, persist func(string) error) (xuid, gamertag string, err error) {
+	if persist == nil {
+		return "", "", ErrAuthenticationFailed
+	}
+	var selected *session
+	err = signInSession(ctx, func() (*session, error) {
+		ticket, id, err := requestWAMToken(ctx, xblScope, "", 0, nil)
+		if err != nil {
+			return nil, err
+		}
+		userToken, err := xblUserAuth(ctx, ticket)
+		if err != nil {
+			return nil, err
+		}
+		s, err := xblXSTS(ctx, userToken)
+		if err != nil {
+			return nil, err
+		}
+		s.accountID = id
+		selected = s
+		return s, nil
+	}, persist)
+	if err != nil || selected == nil {
+		return "", "", err
+	}
+	return selected.xuid, selected.gtg, nil
+}
+
