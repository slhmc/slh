{
  "name": "smile-launcher",
  "private": true,
  "version": "0.2.0",
  "description": "SLH, a portable Windows Minecraft launcher",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "npm run build && npm run test && cargo test --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "test": "vitest run",
    "test:bedrock-native": "powershell -ExecutionPolicy Bypass -File scripts/test-bedrock-native.ps1",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "build:bedrock-native": "powershell -ExecutionPolicy Bypass -File scripts/build-bedrock-native.ps1",
    "tauri:build": "npm run build:bedrock-native && tauri build --no-bundle",
    "portable": "powershell -ExecutionPolicy Bypass -File scripts/build-portable.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-notification": "2.4.0",
    "@tauri-apps/plugin-opener": "2.5.4",
    "pixelarticons": "^2.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "skin3d": "0.1.3",
    "skinview-utils": "0.7.1",
    "skinview3d": "^3.4.2",
    "three": "0.182.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "overrides": {
    "skin3d": {
      "three": "$three"
    }
  }
}
